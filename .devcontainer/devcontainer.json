{
  "name": "user-list-exercise",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-20-bookworm",
  "postCreateCommand": "npm ci && npx playwright install --with-deps chromium",
  "forwardPorts": [5199, 9323],
  "portsAttributes": {
    "5199": { "label": "App" },
    "9323": { "label": "Playwright report" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-playwright.playwright"]
    }
  }
}
